# ArchiteX Backend — Environment Variables
# Copy this file to .env and fill in your API keys

# Required: Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Zhipu GLM fallback (https://open.bigmodel.cn/)
ZHIPU_API_KEY=your_zhipu_api_key_here

# Optional: Comma-separated allowed CORS origins (default: * allows all)
# Example: https://architex-app.vercel.app,https://localhost:5173
ALLOWED_ORIGINS=*
